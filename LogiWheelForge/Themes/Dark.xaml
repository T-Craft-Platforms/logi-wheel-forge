<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowColor">#141824</Color>
    <Color x:Key="SurfaceColor">#1D2332</Color>
    <Color x:Key="ElevatedColor">#252D3E</Color>
    <Color x:Key="BorderColor">#354058</Color>
    <Color x:Key="TextColor">#F4F7FB</Color>
    <Color x:Key="MutedColor">#99A8BB</Color>
    <Color x:Key="AccentColor">#579DC2</Color>
    <Color x:Key="AccentStrongColor">#79BDDD</Color>
    <Color x:Key="SuccessColor">#35D07F</Color>
    <Color x:Key="WarningColor">#FFB547</Color>
    <Color x:Key="DangerColor">#FF4967</Color>
    <Color x:Key="InputColor">#191F2D</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentStrongColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
</ResourceDictionary>