<UserControl x:Class="LogiWheelForge.Controls.ModuleHeader"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Name="Header" SizeChanged="OnSizeChanged">
 <Grid Margin="0,0,0,20">
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="SwitchColumn" Width="Auto"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Width="34" Height="34" VerticalAlignment="Top" Background="{DynamicResource ElevatedBrush}" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Foreground="{DynamicResource AccentBrush}" Text="{Binding Glyph, ElementName=Header}"/></Border>
   <StackPanel Grid.Column="1"><TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding ModuleName, ElementName=Header}"/><TextBlock Margin="0,5,12,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="{Binding Description, ElementName=Header}"/></StackPanel>
  </Grid>
  <StackPanel x:Name="ModuleSwitch" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
   <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Disabled"/><Style.Triggers><DataTrigger Binding="{Binding ModuleEnabled, ElementName=Header}" Value="True"><Setter Property="Text" Value="Enabled"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <ToggleButton Style="{DynamicResource ModuleToggleStyle}" IsChecked="{Binding ModuleEnabled, ElementName=Header, Mode=TwoWay}" AutomationProperties.Name="{Binding SwitchName, ElementName=Header}" ToolTip="Enable or disable this module"/>
  </StackPanel>
 </Grid>
</UserControl>
