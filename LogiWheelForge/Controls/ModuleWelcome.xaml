<UserControl x:Class="LogiWheelForge.Controls.ModuleWelcome"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Welcome">
 <Border Style="{StaticResource CardStyle}" Padding="32" VerticalAlignment="Top">
  <StackPanel HorizontalAlignment="Center" MaxWidth="460">
   <Border Width="76" Height="76" CornerRadius="24" Background="{DynamicResource ElevatedBrush}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="38" Foreground="{DynamicResource AccentBrush}" Text="{Binding Glyph, ElementName=Welcome}"/></Border>
   <TextBlock Margin="0,20,0,10" TextAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="{Binding ModuleName, ElementName=Welcome}"/>
   <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="{Binding Description, ElementName=Welcome}"/>
   <Button Margin="0,24,0,0" Content="Enable" HorizontalAlignment="Center" Click="Enable_OnClick" AutomationProperties.Name="{Binding EnableName, ElementName=Welcome}"/>
  </StackPanel>
 </Border>
</UserControl>
