<UserControl x:Class="LogiWheelForge.Controls.MapperRuleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:LogiWheelForge.Controls" x:Name="RuleEditor">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Themes/MapperControls.xaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <Grid SizeChanged="OnEditorSizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="InputColumn" /><ColumnDefinition x:Name="OutputColumn" Width="0" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border x:Name="InputCard" Style="{StaticResource CardStyle}" Padding="20" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource EyebrowStyle}" Text="WHEN THIS HAPPENS" />
                <TextBlock Style="{StaticResource MapperLabel}" Text="Wheel control" />
                <ComboBox AutomationProperties.Name="Wheel control" IsEditable="True" Text="{Binding Control, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Choices.Controls, ElementName=RuleEditor}"
                          ToolTip="Choose a detected control, or type its name (for example Button1)." />
                <TextBlock Style="{StaticResource MapperLabel}" Text="Trigger" />
                <ComboBox AutomationProperties.Name="Trigger" SelectedItem="{Binding Trigger}" ItemsSource="{Binding Choices.Triggers, ElementName=RuleEditor}" />
                <Grid Visibility="{Binding IsStepTrigger, Converter={StaticResource ShowWhenTrue}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource MapperLabel}" Text="Direction" />
                    <ComboBox Grid.Row="1" Margin="0,0,8,0" SelectedItem="{Binding Direction}" ItemsSource="{Binding Choices.Directions, ElementName=RuleEditor}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource MapperLabel}" Text="Step (%)" />
                    <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding StepPercentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"  AutomationProperties.Name="Step percent"/>
                </Grid>
                <StackPanel Visibility="{Binding IsRangeTrigger, Converter={StaticResource ShowWhenTrue}}">
                    <TextBlock Style="{StaticResource MapperLabel}" Text="Active range (%)" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding MinPercentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" ToolTip="Minimum percentage"  AutomationProperties.Name="Minimum percentage"/>
                        <TextBlock Grid.Column="1" Text="to" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                        <TextBox Grid.Column="2" Text="{Binding MaxPercentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" ToolTip="Maximum percentage"  AutomationProperties.Name="Maximum percentage"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="OutputCard" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource CardStyle}" Padding="20" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource EyebrowStyle}" Text="DO THIS" />
                <TextBlock Style="{StaticResource MapperLabel}" Text="Output action" />
                <ComboBox AutomationProperties.Name="Output action" SelectedItem="{Binding Action}" ItemsSource="{Binding Choices.Actions, ElementName=RuleEditor}" />
                <StackPanel Visibility="{Binding UsesOutput, Converter={StaticResource ShowWhenTrue}}">
                    <TextBlock Style="{StaticResource MapperLabel}" Text="{Binding OutputLabel}" />
                    <ComboBox AutomationProperties.Name="{Binding OutputLabel}" IsEditable="True" Text="{Binding Output, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" ItemsSource="{Binding OutputChoices}" />
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="{Binding OutputHint}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsKeyOrButtonAction, Converter={StaticResource ShowWhenTrue}}">
                    <TextBlock Style="{StaticResource MapperLabel}" Text="Behavior" />
                    <ComboBox AutomationProperties.Name="Output behavior" SelectedItem="{Binding Mode}" ItemsSource="{Binding Choices.Modes, ElementName=RuleEditor}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsMovementAction, Converter={StaticResource ShowWhenTrue}}">
                    <TextBlock Style="{StaticResource MapperLabel}" Text="Movement / scroll scale" />
                    <TextBox Text="{Binding OutputScaleText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"  AutomationProperties.Name="Movement or scroll scale"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsHoldTargetAction, Converter={StaticResource ShowWhenTrue}}">
                    <TextBlock Style="{StaticResource MapperLabel}" Text="Hold strength (%)" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding ForceStrength}" />
                    <TextBlock Style="{StaticResource MapperLabel}" Text="Target position (%)" />
                    <TextBox Text="{Binding TargetPercentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"  AutomationProperties.Name="Target position percent"/>
                    <TextBlock Style="{StaticResource MapperLabel}" Text="Release the hold" />
                    <ComboBox AutomationProperties.Name="Release hold condition" SelectedItem="{Binding ForceRelease}" ItemsSource="{Binding Choices.ForceReleases, ElementName=RuleEditor}" />
                </StackPanel>
                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource WarningBrush}"
                           Visibility="{Binding IsForceAction, Converter={StaticResource ShowWhenTrue}}"
                           Text="Enable resistance in the Resistance tab to use wheel position actions." />
            </StackPanel>
        </Border>
        <Expander Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Header="Fine tuning" Visibility="{Binding HasFineTuning, Converter={StaticResource ShowWhenTrue}}">
            <Border Margin="0,8,0,0" Style="{StaticResource CardStyle}" Padding="20,6,20,20">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsStepTrigger, Converter={StaticResource ShowWhenTrue}}">
                        <TextBlock Style="{StaticResource MapperLabel}" Text="Step behavior" />
                        <ComboBox AutomationProperties.Name="Step behavior" SelectedItem="{Binding StepMode}" ItemsSource="{Binding Choices.StepModes, ElementName=RuleEditor}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsRangeTrigger, Converter={StaticResource ShowWhenTrue}}">
                        <TextBlock Style="{StaticResource MapperLabel}" Text="Range hysteresis (%)" />
                        <TextBox Text="{Binding HysteresisPercentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"  AutomationProperties.Name="Range hysteresis percent"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsAxisTrigger, Converter={StaticResource ShowWhenTrue}}">
                        <TextBlock Style="{StaticResource MapperLabel}" Text="Dead zone (%)" />
                        <TextBox Text="{Binding DeadZonePercentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"  AutomationProperties.Name="Dead zone percent"/>
                        <TextBlock Style="{StaticResource MapperLabel}" Text="Response curve exponent" />
                        <TextBox Text="{Binding CurveExponentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"  AutomationProperties.Name="Response curve exponent"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsTapAction, Converter={StaticResource ShowWhenTrue}}">
                        <TextBlock Style="{StaticResource MapperLabel}" Text="Tap duration (ms)" />
                        <TextBox Text="{Binding DurationMsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"  AutomationProperties.Name="Tap duration milliseconds"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Expander>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="2,12,2,0" Text="{Binding ValidationMessage}" FontSize="12" Foreground="{DynamicResource WarningBrush}" />
    </Grid>
</UserControl>
