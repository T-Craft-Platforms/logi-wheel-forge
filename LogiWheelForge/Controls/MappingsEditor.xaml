<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:LogiWheelForge.Controls" x:Class="LogiWheelForge.Controls.MappingsEditor" SizeChanged="OnEditorSizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="280"/>
            <ColumnDefinition x:Name="DetailsColumn"/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="MappingList" Margin="0,0,16,0">
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="+ Add" Command="{Binding AddRuleCommand}" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Add mapping"/>
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Mappings"/>
            </DockPanel>
            <ListBox ItemsSource="{Binding SelectedProfile.Rules}" SelectedItem="{Binding SelectedRule, Mode=TwoWay}" MaxHeight="540" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Mappings">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Control}"/>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="{Binding Summary}"/>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="{Binding ActivityState}"/>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Text="{Binding ValidationMessage}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="No mappings yet. Add a control and choose what it should do.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProfile.Rules.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Margin="0,10,0,0" Content="Remove selected mapping" Command="{Binding DeleteRuleCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel x:Name="MappingDetails" Grid.Column="1">
            <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding ControlAvailability}"/>
            <ContentControl Content="{Binding SelectedRule}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <controls:MapperRuleEditor Choices="{Binding DataContext, RelativeSource={RelativeSource AncestorType=controls:MappingsEditor}}"/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </StackPanel>
    </Grid>
</UserControl>
