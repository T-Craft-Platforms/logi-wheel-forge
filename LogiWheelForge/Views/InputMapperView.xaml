<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:LogiWheelForge.Controls" xmlns:views="clr-namespace:LogiWheelForge.Views" x:Class="LogiWheelForge.Views.InputMapperView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MapperControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <controls:BooleanVisibilityConverter x:Key="Show"/>
            <controls:BooleanVisibilityConverter x:Key="Hide" Invert="True"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <controls:ModuleHeader ModuleName="{Binding PageTitle}" RuntimeStatus="{Binding RuntimeStatus}" Glyph="↔" Description="Turn wheel controls into keyboard and mouse actions." SwitchName="Input Mapper enabled" ModuleEnabled="{Binding DataContext.IsInputMapperModuleEnabled, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=True, Mode=TwoWay}"/>
        <controls:ModuleWelcome Grid.Row="1" ModuleName="Input Mapper" Glyph="↔" EnableName="Enable Input Mapper" Description="Make your wheel work your way. Enable Input Mapper to link applications and explore your mappings. Your profiles will be ready when you return." ModuleEnabled="{Binding DataContext.IsInputMapperModuleEnabled, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=True, Mode=TwoWay}" Visibility="{Binding DataContext.IsInputMapperModuleEnabled, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=True, Converter={StaticResource Hide}}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding DataContext.IsInputMapperModuleEnabled, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=True, Converter={StaticResource Show}}">
            <Grid Margin="0,0,12,0">
                <StackPanel Visibility="{Binding IsEditorOpen, Converter={StaticResource Hide}}">
                    <DockPanel Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="+ New profile" Command="{Binding AddProfileCommand}"/>
                        <TextBlock VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="Your profiles"/>
                    </DockPanel>
                    <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="{Binding EditStatus}"/>
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Text="{Binding SaveError}"/>
                    <Border Padding="32">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Make your wheel work your way"/>
                            <TextBlock Margin="0,10,0,20" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Create a profile, link your applications, then explore the four starter mappings."/>
                            <Button HorizontalAlignment="Left" Content="Create a profile" Command="{Binding AddProfileCommand}"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="276" MinHeight="168" Margin="0,0,16,16" Padding="22" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=views:InputMapperView}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                    <StackPanel>
                                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Margin="0,8,0,12" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Text="{Binding ApplicationsSummary}"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Text="{Binding EnabledLabel}"/>
                                            <TextBlock Text="{Binding Rules.Count, StringFormat={}{0} mappings}"/>
                                        </DockPanel>
                                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Text="{Binding SetupWarning}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Visibility="{Binding IsEditorOpen, Converter={StaticResource Show}}">
                    <Button HorizontalAlignment="Left" Margin="0,0,0,18" Content="← Back to profiles" Command="{Binding BackCommand}" Style="{StaticResource GhostButton}"/>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}" Text="{Binding EditStatus}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock FontSize="23" FontWeight="SemiBold" Text="{Binding SelectedProfile.Name}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Text="{Binding SaveError}"/>
                    <CheckBox Margin="0,0,0,16" Content="Profile enabled" IsChecked="{Binding SelectedProfile.Enabled}"/>
                    <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="{Binding Status}"/>
                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" MaxHeight="48" Text="{Binding InputPreview}"/>
                            <TextBlock Margin="0,4,0,8" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="Preview simulates this profile without sending input or resistance." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TabControl SelectedIndex="{Binding EditorTabIndex, Mode=TwoWay}" Margin="0,0,0,20">
                        <TabItem Header="Mappings">
                            <controls:MappingsEditor/>
                        </TabItem>
                        <TabItem Header="Applications">
                            <TabItem.DataContext>
                                <Binding Path="SelectedProfile"/>
                            </TabItem.DataContext>
                            <Border Style="{StaticResource CardStyle}" Padding="20">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Profile setup"/>
                                    <TextBlock Style="{StaticResource MapperLabel}" Text="Profile name"/>
                                    <TextBox MaxLength="64" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Profile name"/>
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" Text="{Binding NameError}" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,22,0,6" FontSize="16" FontWeight="SemiBold" Text="Linked applications"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="Mappings activate when a linked application is in the foreground."/>
                                    <Button Margin="0,16,0,12" HorizontalAlignment="Left" Content="Pick an open window" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.PickWindowCommand, RelativeSource={RelativeSource AncestorType=views:InputMapperView}}"/>
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" Text="{Binding ApplicationsError}" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Text="{Binding DataContext.ApplicationInputError, RelativeSource={RelativeSource AncestorType=views:InputMapperView}}"/>
                                    <ListBox MaxHeight="180" ItemsSource="{Binding ProcessPaths}" SelectedItem="{Binding DataContext.SelectedProcessPath, RelativeSource={RelativeSource AncestorType=views:InputMapperView}, Mode=TwoWay}" AutomationProperties.Name="Linked applications">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Margin="0,8" Foreground="{DynamicResource WarningBrush}" FontSize="12" Text="Link an application to activate this profile.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProcessPaths.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button HorizontalAlignment="Left" Content="Remove selected application" Style="{StaticResource GhostButton}" Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=views:InputMapperView}}"/>
                                    <Expander Margin="0,14,0,0" Header="Add an executable path manually">
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource MapperLabel}" Text="Full path to an .exe file"/>
                                            <TextBox AutomationProperties.Name="Executable path" Text="{Binding DataContext.ManualProcessPath, RelativeSource={RelativeSource AncestorType=views:InputMapperView}, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="Add application" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.AddProcessCommand, RelativeSource={RelativeSource AncestorType=views:InputMapperView}}"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </TabItem>
                        <TabItem Header="Resistance">
                            <TabItem.DataContext>
                                <Binding Path="SelectedProfile"/>
                            </TabItem.DataContext>
                            <Border Style="{StaticResource CardStyle}" Padding="20">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Wheel feel"/>
                                    <TextBlock Margin="0,6,0,16" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="Tune centering and damping for this profile. Your wheel driver must expose spring and damper effects."/>
                                    <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding DataContext.ForceStatus, RelativeSource={RelativeSource AncestorType=views:InputMapperView}}"/>
                                    <TextBlock Margin="0,0,0,12" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="{Binding DataContext.ResistanceAvailability, RelativeSource={RelativeSource AncestorType=views:InputMapperView}}"/>
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Text="{Binding ResistanceError}"/>
                                    <CheckBox Content="Enable resistance" IsChecked="{Binding ResistanceEnabled}"/>
                                    <StackPanel IsEnabled="{Binding ResistanceEnabled}" Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource MapperLabel}" Text="{Binding CenterStrength, StringFormat=Center strength · {0:0}%}"/>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding CenterStrength}"/>
                                        <TextBlock Style="{StaticResource MapperLabel}" Text="{Binding DampingStrength, StringFormat=Damping strength · {0:0}%}"/>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding DampingStrength}"/>
                                        <CheckBox Margin="0,20,0,8" Content="Soft detents" IsChecked="{Binding DetentsEnabled}"/>
                                        <StackPanel Visibility="{Binding DetentsEnabled, Converter={StaticResource ShowWhenTrue}}">
                                            <TextBlock Style="{StaticResource MapperLabel}" Text="Detent spacing (%)"/>
                                            <TextBox Text="{Binding DetentSpacingPercentText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Style="{StaticResource MapperLabel}" Text="{Binding DetentStrength, StringFormat=Detent strength · {0:0}%}"/>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding DetentStrength}"/>
                                            <Expander Margin="0,12,0,0" Header="Detent fine tuning">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource MapperLabel}" Text="Detent hysteresis (%)"/>
                                                    <TextBox Text="{Binding DetentHysteresisPercentText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                    <Button HorizontalAlignment="Left" Content="Delete profile" Command="{Binding DeleteProfileCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
